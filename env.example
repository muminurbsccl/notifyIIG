# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only application configuration. Never expose these in client code.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APP_BASE_URL=
APP_ENCRYPTION_KEY=

# Postgres connection for scripts/apply-sql.mjs (migrations/seed).
# Use the IPv4 session pooler: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Transactional email provider
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Official WhatsApp Cloud API
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Optional Discord incoming webhook
DISCORD_WEBHOOK_URL=
